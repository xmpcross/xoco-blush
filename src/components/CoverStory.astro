---
import { Image } from "astro:assets";
import CategoryTag from "@/components/CategoryTag.astro";
import RatingStars from "@/components/ui/RatingStars.astro";
import { bylineShort, formatDate, postHref, readMinutes, type Post } from "@/lib/posts";
import { postRating } from "@/lib/reviews";

/**
 * A story given the full width of its track: the photograph runs edge to edge
 * and the headline is set over its foot on a gradient scrim, so the top of the
 * picture is never covered.
 *
 * `feature` is the shorter variant used mid-page, where the block punctuates
 * the grid rather than opening the page.
 */
interface Props {
  post: Post;
  kicker?: string;
  variant?: "lead" | "feature";
  /** Date only, no byline and no read time. Used on the front page. */
  dateOnly?: boolean;
  /** Drops the read time while keeping the byline. */
  showReadTime?: boolean;
  eager?: boolean;
  headingLevel?: "h2" | "h3";
  class?: string;
}

const {
  post,
  kicker,
  variant = "lead",
  dateOnly = false,
  showReadTime = true,
  eager = false,
  headingLevel = "h2",
  class: className = "",
} = Astro.props;

const data = post.data;
const isLead = variant === "lead";
const Heading = headingLevel;
/* Only a scored review has one, so every other cover story is untouched. */
const rating = postRating(post);
---

<article
  class:list={["cover-story", !isLead && "cover-story--feature", className]}
>
  <div class="cover-story__media">
    <Image
      src={data.cover.src}
      alt=""
      widths={[640, 960, 1280, 1600, 2000]}
      sizes="(min-width: 88rem) 1344px, 100vw"
      loading={eager ? "eager" : "lazy"}
      fetchpriority={eager ? "high" : undefined}
      decoding="async"
    />
  </div>
  <div class="cover-story__scrim"></div>

  <a class="hit" href={postHref(post)} aria-label={data.title}></a>

  <div class="cover-story__body">
    <div class="chip-row">
      <CategoryTag category={data.category} variant="glass" />
      {rating !== undefined && <RatingStars value={rating} size={isLead ? "md" : "sm"} onImage />}
      {kicker && <span class="label cover-story__kicker">{kicker}</span>}
    </div>

    <Heading class:list={[isLead ? "txt-d" : "txt-h1", "cover-story__title"]}>
      {data.title}
    </Heading>

    {isLead && <p class="txt-l cover-story__standfirst">{data.excerpt}</p>}

    <p class="label cover-story__meta meta__facts--ruled">
      {
        !dateOnly && (
          <>
            By {bylineShort(post)}
            <span class="meta__rule" aria-hidden="true" />
          </>
        )
      }
      <time datetime={data.date.toISOString()}>{formatDate(data.date)}</time>
      {
        !dateOnly && showReadTime && (
          <>
            <span class="meta__rule" aria-hidden="true" />
            {readMinutes(post)} min read
          </>
        )
      }
    </p>
  </div>
</article>

<style>
  .cover-story__kicker {
    color: rgb(255 255 255 / 0.72);
    padding-inline: 0.25rem;
  }

  .cover-story__meta {
    color: rgb(255 255 255 / 0.78);
    font-weight: 550;
  }
</style>
