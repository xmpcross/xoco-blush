---
import type { AstroComponentFactory } from "astro/runtime/server/index.js";
import { getImage } from "astro:assets";
import type { ImageMetadata } from "astro";
import { siteConfig } from "@/config/site";
import { websiteSchema } from "@/lib/schema";
import "@/styles/global.css";

interface Props {
  title?: string;
  description?: string;
  /**
   * The share card. Hand it an imported image — a post cover, a contributor
   * portrait — and it is cropped to card proportions at build time. A string
   * path is used as-is, for images that already live in `public/`.
   */
  image?: ImageMetadata | string;
  imageAlt?: string;
  type?: "website" | "article";
  noindex?: boolean;
  /** Extra class on <body>. Used by the immersive article opening, which
      lifts the header onto the artwork. */
  bodyClass?: string;
  prevUrl?: string;
  nextUrl?: string;
  /** A section or contributor feed, advertised alongside the site-wide one. */
  feed?: { href: string; title: string };
  structuredData?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title = siteConfig.title,
  description = siteConfig.description,
  image,
  imageAlt,
  type = "website",
  noindex = false,
  bodyClass,
  prevUrl,
  nextUrl,
  feed,
  structuredData,
} = Astro.props;

/* Facebook, X, LinkedIn and Slack all crop to 1200x630, so the card is cut to
   that here rather than shipping a 4000px cover and letting each of them take a
   different slice of it.

   Both dimensions are clamped to the source, because Astro will not enlarge an
   image: asking for 1200x630 from something smaller returns whatever it could
   actually produce, and the `og:image:width` below would then be a number no
   scraper could verify. */
const cardRatio = 1200 / 630;
const cardSource = image && typeof image !== "string" ? image : undefined;
const cardWidth = Math.min(1200, cardSource?.width ?? 1200);
const cardHeight = Math.min(Math.round(cardWidth / cardRatio), cardSource?.height ?? 630);
const card = cardSource
  ? await getImage({
      src: cardSource,
      width: cardWidth,
      height: cardHeight,
      fit: "cover",
      position: "center",
      format: "jpeg",
      quality: 82,
    })
  : undefined;
const socialImage = card?.src ?? (typeof image === "string" ? image : siteConfig.socialImage);
const socialImageAlt = imageAlt ?? `${siteConfig.name} — ${siteConfig.tagline}`;

const canonical = new URL(Astro.url.pathname, siteConfig.siteUrl).toString();
/* Rendered onto <html> so a pinned default paints correctly on the first frame.
   "system" cannot be known at build time, so it starts light and the blocking
   script below corrects it before paint. */
const defaultColorMode = siteConfig.defaultColorMode;
const initialTheme = defaultColorMode === "dark" ? "dark" : "light";
const absoluteImage = new URL(socialImage, siteConfig.siteUrl).toString();
const pageTitle = title === siteConfig.title ? title : `${title} | ${siteConfig.name}`;
/* Every page says what the publication is; pages that are a *thing* — an
   article, a review — hand down their own graph instead. */
const schema = structuredData ?? websiteSchema();

// Optional: renders nothing once the file is deleted.
const BuyButton = Object.values(
  import.meta.glob<{ default: AstroComponentFactory }>("../components/BuyButton.astro", {
    eager: true,
  }),
)[0]?.default;
---

<!doctype html>
<html lang={siteConfig.language} data-theme={initialTheme}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link
      rel="preload"
      href="/fonts/manrope/Manrope-Variable-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/mulish/Mulish-Variable-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical} />
    {prevUrl && <link rel="prev" href={new URL(prevUrl, siteConfig.siteUrl).toString()} />}
    {nextUrl && <link rel="next" href={new URL(nextUrl, siteConfig.siteUrl).toString()} />}
    <link rel="alternate" type="application/rss+xml" title={`${siteConfig.name} RSS`} href={new URL("/rss.xml", siteConfig.siteUrl).toString()} />
    {
      feed && (
        <link
          rel="alternate"
          type="application/rss+xml"
          title={`${feed.title} RSS`}
          href={new URL(feed.href, siteConfig.siteUrl).toString()}
        />
      )
    }
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta property="og:locale" content={siteConfig.locale} />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={siteConfig.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={absoluteImage} />
    <meta property="og:image:alt" content={socialImageAlt} />
    {
      card && (
        <>
          <meta property="og:image:type" content="image/jpeg" />
          <meta property="og:image:width" content={String(cardWidth)} />
          <meta property="og:image:height" content={String(cardHeight)} />
        </>
      )
    }
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={absoluteImage} />
    <meta name="twitter:image:alt" content={socialImageAlt} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />
    <script is:inline define:vars={{ defaultColorMode }}>
      (() => {
        const storageKey = "blush-theme";
        const root = document.documentElement;
        const themePreference = window.matchMedia("(prefers-color-scheme: dark)");
        let storedTheme;

        try {
          storedTheme = localStorage.getItem(storageKey);
        } catch {
          storedTheme = null;
        }

        const updateThemeButtons = (theme) => {
          document.querySelectorAll("[data-theme-toggle]").forEach((button) => {
            button.setAttribute("aria-label", theme === "dark" ? "Switch to light mode" : "Switch to dark mode");
          });
        };

        const setTheme = (theme, persist = false) => {
          root.dataset.theme = theme;
          if (persist) {
            storedTheme = theme;
            try {
              localStorage.setItem(storageKey, theme);
            } catch {}
          }
          updateThemeButtons(theme);
        };

        /* A stored choice always wins. Otherwise the site's configured default
           applies, and only "system" defers to the operating system. */
        const preferredTheme =
          storedTheme === "light" || storedTheme === "dark"
            ? storedTheme
            : defaultColorMode === "system"
              ? themePreference.matches
                ? "dark"
                : "light"
              : defaultColorMode;

        setTheme(preferredTheme);

        themePreference.addEventListener("change", (event) => {
          if (defaultColorMode !== "system") return;
          if (storedTheme === "light" || storedTheme === "dark") return;
          setTheme(event.matches ? "dark" : "light");
        });

        // Scroll reveals are CSS-only wherever view timelines exist. The
        // observer below is the fallback for everywhere else, so it stays off
        // when the browser can already do the work itself.
        const hasViewTimeline =
          typeof CSS !== "undefined" &&
          typeof CSS.supports === "function" &&
          CSS.supports("animation-timeline: view()");
        const canReveal =
          !hasViewTimeline &&
          "IntersectionObserver" in window &&
          !window.matchMedia("(prefers-reduced-motion: reduce)").matches;

        if (canReveal) root.classList.add("can-reveal");

        window.addEventListener("DOMContentLoaded", () => {
          updateThemeButtons(root.dataset.theme || preferredTheme);
          document.querySelectorAll("[data-theme-toggle]").forEach((button) => {
            button.addEventListener("click", () => {
              setTheme(root.dataset.theme === "dark" ? "light" : "dark", true);
            });
          });

          if (!canReveal) return;

          const revealObserver = new IntersectionObserver(
            (entries) => {
              entries.forEach((entry) => {
                if (!entry.isIntersecting) return;
                entry.target.classList.add("is-visible");
                revealObserver.unobserve(entry.target);
              });
            },
            // Fire as soon as any part of the block enters, and reach 10%
            // past the bottom edge so a section sitting just under the fold has
            // already faded in by the time it is scrolled to. A percentage
            // threshold would hold tall sections back until a large slice of
            // them was on screen, which reads as content failing to load.
            { threshold: 0, rootMargin: "0px 0px 10% 0px" },
          );

          // The same list as the two in global.css — keep the three in step.
          const revealSelector = [
            ".reveal",
            ".grid-cards > *",
            ".highlights > *",
            ".spotlight > *",
            ".sections-row > *",
            ".rail__track > *",
            ".verdict-lead",
            ".verdict-list",
            ".standards__lead",
            ".standards__item",
            ".cta",
            ".site-footer__columns > *",
            ".row",
          ].join(", ");

          const observeAll = (scope) =>
            scope.querySelectorAll(revealSelector).forEach((element) => revealObserver.observe(element));

          observeAll(document);

          // Search and saved stories draw their rows after load; without this
          // they would sit at opacity 0 for good.
          new MutationObserver((mutations) => {
            mutations.forEach((mutation) => {
              mutation.addedNodes.forEach((node) => {
                if (!(node instanceof Element)) return;
                if (node.matches(revealSelector)) revealObserver.observe(node);
                observeAll(node);
              });
            });
          }).observe(document.body, { childList: true, subtree: true });
        });
      })();
    </script>
  </head>
  <body class={bodyClass}>
    <a class="skip-link" href="#content">Skip to content</a>
    <slot />
    {BuyButton && <BuyButton />}
  </body>
</html>
