---
import { getCollection, render } from "astro:content";
import PostCard from "@/components/PostCard.astro";
import SaveButton from "@/components/SaveButton.astro";
import ShareButton from "@/components/ShareButton.astro";
import ShareSheet from "@/components/ShareSheet.astro";
import Lightbox from "@/components/content/Lightbox.astro";
import PostHero from "@/components/PostHero.astro";
import HighsLows from "@/components/review/HighsLows.astro";
import RatingBreakdown from "@/components/review/RatingBreakdown.astro";
import VerdictPanel from "@/components/review/VerdictPanel.astro";
import WhereToBuy from "@/components/review/WhereToBuy.astro";
import SectionHeader from "@/components/SectionHeader.astro";
import SiteFooter from "@/components/SiteFooter.astro";
import SiteHeader from "@/components/SiteHeader.astro";
import Avatar from "@/components/ui/Avatar.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import {
  authorSlug,
  formatDate,
  getRelated,
  postBylines,
  postSlug,
  storyLayoutFor,
  tagSlug,
  visiblePosts,
  type Post,
} from "@/lib/posts";
import { isReview } from "@/lib/reviews";
import { postBreadcrumbSchema, postSchema } from "@/lib/schema";
import { siteConfig } from "@/config/site";

export async function getStaticPaths() {
  const allPosts = visiblePosts(await getCollection("posts"));
  return allPosts.map((post) => ({
    params: { slug: postSlug(post) },
    props: { post, allPosts },
  }));
}

interface Props {
  post: Post;
  allPosts: Post[];
}

const { post, allPosts } = Astro.props;
const { Content } = await render(post);
const related = getRelated(allPosts, post);
const data = post.data;
const slug = postSlug(post);
const layout = storyLayoutFor(post);
/* An immersive opening owns the top of the page, so the header is lifted onto
   the artwork. */
const immersive = layout === "immersive";
const bylines = postBylines(post);
const articleUrl = new URL(`/post/${slug}/`, siteConfig.siteUrl).toString();
const absoluteImageUrl = new URL(data.cover.src.src, siteConfig.siteUrl).toString();
/* A scored review is declared as a `Review` carrying its rating; everything
   else is an `Article`. Both are followed by the trail the page itself renders
   — see `src/lib/schema.ts`. */
const structuredData = [postSchema(post, absoluteImageUrl), postBreadcrumbSchema(post)];
/** The blocks a review adds. `undefined` on every other kind of story. */
const review = isReview(post) ? post.data.review : undefined;
---

<BaseLayout
  title={data.title}
  description={data.excerpt}
  image={data.cover.src}
  imageAlt={data.cover.alt}
  type="article"
  structuredData={structuredData}
  bodyClass={immersive ? "has-overlay-header" : undefined}
>
  <SiteHeader posts={allPosts} />

  <div class="reading-progress" aria-hidden="true">
    <div class="reading-progress__bar" data-reading-progress></div>
  </div>

  <main id="content">
    <article data-article>
      <PostHero post={post} />

      <div class="container-reading post-body">
        {/* The verdict opens a review rather than closing it: a reader who
            came for the answer gets it, and the article underneath is then the
            argument for it rather than a wait. */}
        {review && <VerdictPanel review={review} class="review-block" />}
        {review && <HighsLows review={review} class="review-block" />}

        <div class="prose">
          <Content />
        </div>

        {/* The workings, after the reading — an argument first, then the
            arithmetic anyone who disagrees with it will want. */}
        {review && <RatingBreakdown review={review} class="review-block" />}

        {/* And only then, where to buy it. A buy box above the verdict turns a
            review into a listing. */}
        {review && <WhereToBuy review={review} class="review-block" />}

        {
          data.updatedDate && (
            <p class="label txt-dim post-updated">
              Updated{" "}
              <time datetime={data.updatedDate.toISOString()}>
                {formatDate(data.updatedDate, "long")}
              </time>
            </p>
          )
        }

        {/* Who wrote it, what it was filed under, then how to pass it on — one
            rule separating the lot from the reading, and none inside it. */}
        <footer class="post-footer">
          <div class="post-authors">
            {
              bylines.map((byline) => (
                <div class="post-author">
                  <Avatar name={byline.name} size="lg" />
                  <div>
                    <p class="txt-h4">
                      <a class="underline-hover" href={`/author/${authorSlug(byline.name)}/`}>
                        {byline.name}
                      </a>
                    </p>
                    <p class="txt-s txt-dim">{byline.role}</p>
                  </div>
                </div>
              ))
            }
          </div>

          {
            data.tags.length > 0 && (
              <div>
                <p class="label txt-dim post-box__title">Filed under</p>
                <ul class="post-tags" aria-label="Tags">
                  {data.tags.map((tag) => (
                    <li>
                      <a class="chip" href={`/tag/${tagSlug(tag)}/`}>
                        {tag}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            )
          }

          <div class="post-share posthero__actions">
            <ShareButton variant="button" />
            <SaveButton variant="button" slug={slug} />
          </div>
        </footer>
      </div>
    </article>

    {
      related.length > 0 && (
        <section class="container section section-top" aria-labelledby="post-related">
          <SectionHeader
            title="Keep reading"
            href="/posts/"
            linkLabel="Full archive"
            id="post-related"
          />
          <div class="grid-cards grid-cards--3">
            {related.map((item) => (
              <PostCard post={item} headingLevel="h3" dateOnly />
            ))}
          </div>
        </section>
      )
    }
  </main>

  <ShareSheet title={data.title} url={articleUrl} />
  <Lightbox />
  <SiteFooter />

  <script is:inline>
    (() => {
      const article = document.querySelector("[data-article]");
      const progress = document.querySelector("[data-reading-progress]");

      if (article && progress) {
        let ticking = false;

        const update = () => {
          const rect = article.getBoundingClientRect();
          const total = rect.height - window.innerHeight;
          const read = total > 0 ? Math.min(Math.max(-rect.top / total, 0), 1) : 0;
          progress.style.setProperty("--progress", `${(read * 100).toFixed(2)}%`);
          ticking = false;
        };

        update();
        window.addEventListener(
          "scroll",
          () => {
            if (ticking) return;
            ticking = true;
            window.requestAnimationFrame(update);
          },
          { passive: true },
        );
        window.addEventListener("resize", update, { passive: true });
      }

      document.querySelectorAll(".prose pre").forEach((pre, index) => {
        if (pre.closest(".code-copy-frame")) return;

        const code = pre.querySelector("code");
        const wrapper = document.createElement("div");
        const button = document.createElement("button");
        const status = document.createElement("span");
        const labelId = `code-copy-${index}`;

        wrapper.className = "code-copy-frame";
        button.type = "button";
        button.className = "code-copy-button";
        button.setAttribute("aria-describedby", labelId);
        button.textContent = "Copy";
        status.id = labelId;
        status.className = "sr-only";
        status.setAttribute("aria-live", "polite");

        pre.parentNode?.insertBefore(wrapper, pre);
        wrapper.append(pre, button, status);

        button.addEventListener("click", async () => {
          try {
            if (!navigator.clipboard?.writeText) throw new Error("Clipboard API unavailable");

            await navigator.clipboard.writeText(code?.textContent ?? pre.textContent ?? "");
            button.textContent = "Copied";
            status.textContent = "Code copied";
            window.setTimeout(() => {
              button.textContent = "Copy";
            }, 1800);
          } catch {
            button.textContent = "Failed";
            status.textContent = "Copy failed";
            window.setTimeout(() => {
              button.textContent = "Copy";
            }, 1800);
          }
        });
      });
    })();
  </script>

  <style>
    /* Title block sits above the cover so the story opens with type rather
       than with a photograph. */
    .post-head {
      padding-block: clamp(2.5rem, 6vw, 4rem) 0;
    }

    .post-head__meta {
      display: grid;
      justify-items: start;
      gap: 1rem;
    }

    .post-head__standfirst {
      max-width: 48ch;
    }

    .post-head__byline {
      margin-top: 0.5rem;
    }

    /* `auto` inline margins matter here: .container-reading centres the figure
       and a shorthand reset would knock it back to the left edge. */
    .post-head__figure {
      margin: 2.5rem auto 0;
    }

    .post-head__credit {
      margin-top: 0.75rem;
    }

    .post-body {
      padding-top: 3rem;
      padding-bottom: 1rem;
    }

    .post-updated {
      margin-top: 2rem;
    }

    /* One rule, at the top, marking the end of the reading. The blocks inside
       are spaced rather than ruled — three hairlines in a column read as a
       stack of unrelated boxes instead of one closing note. */
    .post-footer {
      display: grid;
      gap: 2rem;
      margin-top: 2.5rem;
      border-top: 1px solid var(--border);
      padding-top: 2rem;
    }

    .post-box__title {
      margin-bottom: 1rem;
    }

    .post-tags {
      display: flex;
      flex-wrap: wrap;
      gap: 0.375rem;
      margin: 0;
      padding: 0;
      list-style: none;
    }

    /* One row per name. A coauthored post stacks them rather than crowding two
       portraits onto one line, because each carries its own role. */
    .post-authors {
      display: grid;
      gap: 1.25rem;
    }

    .post-author {
      display: flex;
      align-items: center;
      gap: 1rem;
    }

    .post-author p + p {
      margin-top: 0.2rem;
    }

    /* Code copy affordance, injected by the script above. */
    .prose :global(.code-copy-frame) {
      position: relative;
    }

    .prose :global(.code-copy-frame pre) {
      padding-top: 3rem;
    }

    .prose :global(.code-copy-button) {
      position: absolute;
      top: 0.6rem;
      right: 0.6rem;
      border: 1px solid var(--border);
      border-radius: var(--r-full);
      background: var(--surface);
      color: var(--muted-foreground);
      cursor: pointer;
      padding: 0.3rem 0.75rem;
      font-size: var(--fs-label);
      font-weight: 650;
      letter-spacing: var(--ls-label);
      text-transform: uppercase;
      transition:
        color 0.18s ease,
        border-color 0.18s ease,
        background-color 0.18s ease;
    }

    .prose :global(.code-copy-button:hover),
    .prose :global(.code-copy-button:focus-visible) {
      border-color: var(--accent);
      background: var(--wash);
      color: var(--accent);
    }
  </style>
</BaseLayout>
