---
import { getCollection } from "astro:content";
import SavedRuntime from "@/components/SavedRuntime.astro";
import SiteFooter from "@/components/SiteFooter.astro";
import SiteHeader from "@/components/SiteHeader.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { siteConfig } from "@/config/site";
import { visiblePosts } from "@/lib/posts";

/**
 * The reader's saved stories. Everything here is per-browser: the page reads
 * the slugs the save buttons wrote to `localStorage`, looks them up in the
 * same `/search-index.json` the search surfaces use, and paints ledger rows.
 * Nothing leaves the browser and there is nothing to sign in to.
 */
const allPosts = visiblePosts(await getCollection("posts"));
---

<BaseLayout
  title="Saved stories"
  description={`Stories you saved on ${siteConfig.name}, kept in this browser.`}
  noindex
>
  <SiteHeader posts={allPosts} />
  <SavedRuntime />
  <main id="content">
    <div class="container saved-page">
      <header class="saved-page-head opener">
        <h1 class="txt-h2">Saved stories</h1>
        <p class="txt-s txt-dim" data-saved-summary aria-live="polite">
          Stories you save are kept in this browser.
        </p>
      </header>

      <div class="index-list saved-page-results" data-saved-results>
        <p class="txt-m txt-dim saved-page-empty">
          Nothing saved yet. Open any article and tap Save to keep it here.
        </p>
      </div>
    </div>
  </main>
  <SiteFooter />

  <script is:inline>
    (() => {
      const results = document.querySelector("[data-saved-results]");
      const summary = document.querySelector("[data-saved-summary]");
      if (!results || !summary) return;

      const { escapeHtml, starsMarkup, load } = window.blushSearch;
      const emptyMarkup = results.innerHTML;

      const rowMarkup = (item, slug) => `
        <div class="saved-item">
          <a class="row row--flush" href="${escapeHtml(item.href)}">
            <p class="label nums row__date">${escapeHtml(item.date)}</p>
            <div class="row__body">
              <div class="row__head"><span class="tag">${escapeHtml(item.category)}</span>${starsMarkup(item.rating)}</div>
              <h2 class="txt-h3 row__title">${escapeHtml(item.title)}</h2>
              <p class="txt-s txt-dim row__excerpt">${escapeHtml(item.excerpt)}</p>
              <p class="label row__byline meta__facts--ruled">By ${escapeHtml(item.author)}<span class="meta__rule" aria-hidden="true"></span><span class="txt-dim">${escapeHtml(item.date)}</span><span class="meta__rule" aria-hidden="true"></span><span class="txt-dim">${escapeHtml(item.readTime)}</span></p>
            </div>
          </a>
          <button type="button" class="saved-item__remove" data-saved-remove="${escapeHtml(slug)}" aria-label="Remove ${escapeHtml(item.title)} from saved stories">Remove</button>
        </div>
      `;

      const render = async () => {
        const slugs = window.blushSaved.list();

        if (slugs.length === 0) {
          summary.textContent = "Stories you save are kept in this browser.";
          results.innerHTML = emptyMarkup;
          return;
        }

        const items = await load();
        const byHref = new Map(items.map((item) => [item.href, item]));
        /* A saved slug with no index entry is a story since unpublished —
           dropped rather than rendered as a dead link. */
        const saved = slugs
          .map((slug) => ({ slug, item: byHref.get(`/post/${slug}/`) }))
          .filter((entry) => entry.item);

        summary.textContent = `${saved.length} ${saved.length === 1 ? "story" : "stories"}, newest saved first`;
        results.innerHTML = saved.length
          ? saved.map((entry) => rowMarkup(entry.item, entry.slug)).join("")
          : emptyMarkup;
      };

      results.addEventListener("click", (event) => {
        const button =
          event.target instanceof Element && event.target.closest("[data-saved-remove]");
        if (!button) return;
        window.blushSaved.remove(button.dataset.savedRemove);
        void render();
      });

      void render();
    })();
  </script>

  <style>
    .saved-page {
      padding-top: clamp(2rem, 6vw, 4rem);
      padding-bottom: var(--section-gap);
    }

    .saved-page-head {
      display: flex;
      flex-wrap: wrap;
      align-items: baseline;
      justify-content: space-between;
      gap: 0.5rem 1.5rem;
      margin-bottom: 1rem;
    }

    /* The ledger has no page header rule above it, so it draws its own — and
       drops it while the empty state is the only content. */
    .saved-page-results {
      border-top: 1px solid var(--border);
    }

    .saved-page-empty {
      padding-block: 2.5rem;
    }

    /* The rows are script-built, so nothing below carries this page's scoping
       attribute — everything is addressed through :global. */
    /* The hairline moves from the row to the wrapper, so it runs under the
       remove control too. */
    .saved-page-results :global(.saved-item) {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: start;
      gap: 1.25rem;
      border-bottom: 1px solid var(--border);
    }

    .saved-page-results :global(.saved-item:last-child) {
      border-bottom: 0;
    }

    .saved-page-results :global(.saved-item .row) {
      min-width: 0;
      border-bottom: 0;
    }

    /* Aligned with the row's first line rather than centred in the void
       beside it, so the control reads as part of its story. */
    .saved-page-results :global(.saved-item__remove) {
      margin-top: 1.45rem;
    }

    /* The shared row grid reserves trailing columns for a thumbnail and an
       arrow these rows never render — collapsed here so the story does not
       stop half a screen short of its remove control. */
    @media (min-width: 48rem) {
      .saved-page-results :global(.saved-item .row) {
        grid-template-columns: 6.5rem minmax(0, 1fr);
      }

      .saved-page-results :global(.saved-item__remove) {
        margin-top: 1.7rem;
      }
    }

    .saved-page-results :global(.row__byline) {
      margin-top: 0.15rem;
    }

    .saved-page-results :global(.saved-item__remove) {
      border: 0;
      background: none;
      padding: 0;
      color: var(--muted-foreground);
      cursor: pointer;
      font-size: var(--fs-label);
      font-weight: 650;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      transition: color 0.22s ease;
    }

    .saved-page-results :global(.saved-item__remove:hover) {
      color: var(--accent);
    }
  </style>
</BaseLayout>
